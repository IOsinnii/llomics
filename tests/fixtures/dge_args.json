{
  "definitions": {
    "A_vs_B": "A - B, adjusted for batch; positive effect = higher in A",
    "C_vs_B": "C - B, adjusted for batch; positive effect = higher in C"
  },
  "analysis_id": "fixture-dge",
  "question": "Which features differ between the groups?",
  "tool": "fixture 1.0",
  "steps": [
    "simulated table"
  ],
  "n_observations": 11,
  "group_sizes": {
    "A": 4,
    "B": 4,
    "C": 3
  },
  "batch_crosstab": {
    "A": {
      "b1": 2,
      "b2": 2
    },
    "B": {
      "b1": 2,
      "b2": 2
    },
    "C": {
      "b1": 3
    }
  },
  "batch_in_design": true,
  "mean_variance": "voom",
  "n_features": 5,
  "fdr": 0.05,
  "min_effect": 0.2,
  "exclude": "^MT-",
  "panel": [
    "F0002",
    "SYM0050",
    "F0400",
    "NOT_MEASURED"
  ],
  "sizes": {
    "A_vs_B": {
      "n_per_group": {
        "A": 4,
        "B": 4
      }
    },
    "C_vs_B": {
      "n_per_group": {
        "C": 3,
        "B": 4
      }
    }
  },
  "contrast_weights": {
    "A_vs_B": {
      "A": 1,
      "B": -1
    },
    "C_vs_B": {
      "C": 1,
      "B": -1
    }
  },
  "filters": [
    {
      "rule": "expression filter",
      "why": "low counts"
    }
  ],
  "source_tables": {
    "A_vs_B": "dge_A_vs_B.tsv",
    "C_vs_B": "dge_C_vs_B.tsv"
  },
  "trust": {
    "mean_variance": {
      "status": "pass",
      "note": "voom with quality weights"
    }
  }
}
